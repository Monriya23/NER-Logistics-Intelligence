# ==============================================================================
# NER Smart Logistics & Road Accessibility Intelligence Platform (SIH26002)
# Environment Configuration Template
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Frontend API URL (for production builds / Vercel deployment)
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# India Meteorological Department (IMD) Weather & Rainfall Integration
# ------------------------------------------------------------------------------
# Official IMD API endpoint for AWS & Gridded Meteorological Bulletins
IMD_API_BASE_URL=https://mausam.imd.gov.in/api

# Official IMD API Access Key / Bearer Token
# Leave empty if credentials are not configured yet (system operates in PROTOTYPE mode)
IMD_API_KEY=

# HTTP Request Timeout in Seconds
IMD_TIMEOUT_SECONDS=10

# Master toggle for live IMD telemetry ingestion (default false in dev/test)
IMD_ENABLED=false

# In-memory Observation Cache TTL in seconds (default 300s / 5 minutes)
IMD_CACHE_TTL_SECONDS=300

# Maximum geodesic distance (km) for matching road segments to nearest IMD AWS station
IMD_MAX_STATION_DISTANCE_KM=50.0

# Freshness window in hours before a weather observation is marked STALE
IMD_FRESHNESS_HOURS=3.0
